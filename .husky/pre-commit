#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-commit checks..."

# Get list of staged JavaScript/TypeScript files
FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx)$' || true)

if [ -z "$FILES" ]; then
  echo "✅ No JavaScript/TypeScript files to analyze."
  exit 0
fi

echo "📋 Files to analyze:"
echo "$FILES"
echo ""

# Run the pre-commit runner script
echo "🔍 Running AI analysis..."
node scripts/pre-commit-runner.js

# Run lint-staged
echo "🔧 Running lint-staged..."
npx lint-staged
