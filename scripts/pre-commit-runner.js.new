#!/usr/bin/env node

const fs = require('fs').promises;
const path = require('path');
const { execSync } = require('child_process');

// Helper function to check if a file exists
async function fileExists(filePath) {
  try {
    await fs.access(filePath);
    return true;
  } catch {
    return false;
  }
}

// Simple configuration for the analyzer
const config = {
  get: (key) => ({
    'groq.apiKey': process.env.GROQ_API_KEY || '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',
    'groq.model': 'llama-3.1-8b-instant'
  }[key])
};

// Import the GroqAIAnalyzer
const { GroqAIAnalyzer } = require('../src/groq-analyzer');
const analyzer = new GroqAIAnalyzer(config);

// Simple synchronous prompt for better compatibility
function promptUser(question) {
  const readline = require('readline');
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
  });

  return new Promise((resolve) => {
    rl.question(question, (answer) => {
      rl.close();
      resolve(answer.trim().toLowerCase());
    });  
  });
}

// Run Jest tests for a specific test file
async function runTests(testFilePath) {
  console.log(`🔍 Running tests for ${path.basename(testFilePath)}...`);
  try {
    execSync(`npx jest ${testFilePath} --passWithNoTests`, {
      stdio: 'inherit',
      encoding: 'utf8'
    });
    console.log(`✅ Tests passed for ${path.basename(testFilePath)}`);
    return true;
  } catch (testError) {
    console.error(`❌ Tests failed for ${path.basename(testFilePath)}`);
    console.log('\nTo fix the tests:');
    console.log(`1. Review the test file: ${testFilePath}`);
    console.log('2. Make sure all test cases are valid');
    console.log('3. Run the tests manually: npx jest ' + testFilePath);
    console.log('\nTo skip test execution, run git commit with --no-verify');
    return false;
  }
}

// Generate test file for a source file
async function generateTestFile(filePath) {
  try {
    console.log(`\n📄 Generating tests for ${filePath}...`);
    
    const normalizedPath = path.normalize(filePath);
    
    // Read the file from disk instead of git to get actual content
    let sourceContent;
    try {
      sourceContent = await fs.readFile(normalizedPath, 'utf8');
    } catch (err) {
      console.error(`❌ Could not read file: ${err.message}`);
      return { success: false, testPath: null };
    }

    // Check if file is empty
    if (!sourceContent.trim()) {
      console.log('ℹ️  File is empty, skipping test generation');
      return { success: true, testPath: null };
    }

    // Generate test code
    const result = await analyzer.analyzeCode(sourceContent, normalizedPath);
    
    if (!result.success) {
      console.error(`❌ Test generation failed: ${result.error}`);
      return { success: false, testPath: null };
    }

    if (!result.testCode || result.testCode.trim().length === 0) {
      console.log('ℹ️  No test code was generated');
      return { success: true, testPath: null };
    }

    // Create test directory if it doesn't exist
    const testDir = path.join(path.dirname(normalizedPath), '__tests__');
    const fileName = path.basename(normalizedPath);
    const testFileName = fileName.replace(/\.js$/, '.test.js').replace(/\.ts$/, '.test.ts');
    const testFilePath = path.join(testDir, testFileName);

    try {
      await fs.mkdir(testDir, { recursive: true });
    } catch (err) {
      if (err.code !== 'EEXIST') {
        console.error(`❌ Could not create test directory: ${err.message}`);
        return { success: false, testPath: null };
      }
    }

    // Write test file
    try {
      await fs.writeFile(testFilePath, result.testCode, 'utf8');
      console.log(`✅ Test file generated: ${testFilePath}`);
      return { success: true, testPath: testFilePath };
    } catch (err) {
      console.error(`❌ Could not write test file: ${err.message}`);
      return { success: false, testPath: null };
    }
  } catch (error) {
    console.error(`❌ Error generating tests for ${filePath}:`, error.message);
    return { success: false, testPath: null };
  }
}

async function run() {
  try {
    console.clear();
    console.log('🚀 Running AI Code Analysis & Test Generation...\n');
    
    if (process.env.NODE_ENV === 'test') {
      console.log('ℹ️  Running in test mode - skipping execution\n');
    }
    
    // Get list of staged JavaScript/TypeScript files
    let filesOutput = '';
    try {
      filesOutput = execSync('git diff --cached --name-only --diff-filter=ACM', {
        encoding: 'utf8',
        maxBuffer: 10 * 1024 * 1024,
        stdio: ['pipe', 'pipe', 'pipe']
      });
    } catch (err) {
      console.log('⚠️  No staged files found');
      return 0;
    }
    
    const files = filesOutput
      .split('\n')
      .filter(Boolean)
      .map(file => file.trim())
      .filter(file => {
        const ext = path.extname(file).toLowerCase();
        return ['.js', '.jsx', '.ts', '.tsx'].includes(ext);
      })
      .filter(file => file.length > 0);
      
    if (!process.stdout.isTTY) {
      console.log('⚠️  Running in non-interactive mode\n');
    }
    
    if (files.length === 0) {
      console.log('✅ No JavaScript/TypeScript files to analyze.');
      return 0;
    }
    
    console.log(`📋 Found ${files.length} file(s) to analyze:`);
    files.forEach(file => console.log(`   - ${file}`));
    console.log('');
    
    // Generate test files for each source file
    let testFiles = [];
    
    // First, generate all test files
    for (const file of files) {
      // Skip test files to avoid recursive test generation
      if (file.endsWith('.test.js') || file.endsWith('.spec.js') || 
          file.endsWith('.test.ts') || file.endsWith('.spec.ts')) {
        console.log(`⏩ Skipping test file: ${file}`);
        continue;
      }
      
      const { success, testPath } = await generateTestFile(file);
      if (success && testPath) {
        testFiles.push({ sourceFile: file, testPath });
      }
      console.log('');
    }
    
    if (testFiles.length === 0) {
      console.log('ℹ️  No test files were generated');
      return 0;
    }
    
    // Only run tests for the file being committed
    const fileBeingCommitted = process.env.HUSKY_GIT_PARAMS 
      ? process.env.HUSKY_GIT_PARAMS.split(' ')[0]
      : null;
      
    if (fileBeingCommitted) {
      const baseName = path.basename(fileBeingCommitted).replace(/\.(js|jsx|ts|tsx)$/, '');
      const testFile = testFiles.find(tf => tf.testPath.includes(baseName));
      
      if (testFile) {
        const testPassed = await runTests(testFile.testPath);
        if (!testPassed) {
          console.error('\n❌ Tests failed. Please fix the issues before committing.');
          console.log('   To commit anyway, use: git commit --no-verify\n');
          return 1; // Block the commit if tests fail
        }
        console.log('\n✅ Tests completed successfully!');
      } else {
        console.log(`\nℹ️  No test file found for ${fileBeingCommitted}`);
      }
    } else {
      console.log('\nℹ️  No specific file being committed - skipping test execution');
    }
    
    return 0;
    
  } catch (error) {
    console.error('❌ Error during execution:', error.message);
    return 1;
  }
}

// Run the function and exit with the appropriate status code
run().then(code => {
  process.exit(code);
}).catch(err => {
  console.error('❌ Unhandled error:', err);
  process.exit(1);
});
